# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# AI API Keys
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Session
SESSION_SECRET=your_session_secret_here

# URLs
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database Configuration
# For local development: Leave commented out to use SQLite
# For production with Neon PostgreSQL: Add your connection string
# Format: postgresql://[user]:[password]@[neon-host]/[database]?sslmode=require
# Example: postgresql://user:password@ep-cool-cloud-123456.us-east-1.aws.neon.tech/skillgap_db?sslmode=require
# DATABASE_URL=your_neon_connection_string_here

# Node Environment
NODE_ENV=development
